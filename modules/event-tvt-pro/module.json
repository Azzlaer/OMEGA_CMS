{
  "name": "Evento TvT PRO",
  "slug": "event-tvt-pro",
  "version": "1.0.0",
  "author": "Omega MU CMS / LatinBattle.com",
  "description": "Ranking público Team vs Team integrado en Rankings, con historial, partidas y selector opcional de personajes de la cuenta.",
  "minimum_core": "0.18.0",
  "enabled_by_default": true,
  "category": "events",
  "config_schema": [
    {
      "key": "show_account_characters",
      "label": "Mostrar selector «Mis personajes»",
      "type": "boolean",
      "default": true,
      "help": "Cuando el visitante inició sesión, muestra sus personajes de Character.AccountID dentro del ranking TvT para consultar sus estadísticas."
    },
    {
      "key": "recent_matches",
      "label": "Partidas recientes",
      "type": "integer",
      "default": 20,
      "min": 5,
      "max": 100
    },
    {
      "key": "ranking_limit",
      "label": "Jugadores en ranking",
      "type": "integer",
      "default": 30,
      "min": 10,
      "max": 100
    },
    {
      "key": "timeline_limit",
      "label": "Acciones por partida",
      "type": "integer",
      "default": 100,
      "min": 20,
      "max": 300
    },
    {
      "key": "show_rewards",
      "label": "Mostrar Zen entregado",
      "type": "boolean",
      "default": true
    },
    {
      "key": "show_objectives",
      "label": "Mostrar objetivos destruidos",
      "type": "boolean",
      "default": true
    }
  ]
}
