{
  "name": "Secure Roulette",
  "slug": "secure-roulette",
  "version": "1.0.2",
  "author": "Omega MU CMS",
  "description": "Ruleta de premios segura para Omega Web. Incluye fix SQL Server/ODBC para parámetros DATEADD.",
  "minimum_core": "0.18.0",
  "enabled_by_default": true,
  "user_menu": {
    "label": "Ruleta Segura",
    "icon": "🎰",
    "order": 30
  },
  "config_schema": [
    {
      "key": "enabled",
      "label": "Ruleta habilitada",
      "type": "boolean",
      "default": true
    },
    {
      "key": "cooldown_minutes",
      "label": "Cooldown entre giros (minutos)",
      "type": "integer",
      "default": 1440,
      "min": 0,
      "max": 525600,
      "help": "0 = sin cooldown funcional. Se mantiene un anti-doble-submit técnico."
    },
    {
      "key": "history_limit",
      "label": "Historial mostrado al usuario",
      "type": "integer",
