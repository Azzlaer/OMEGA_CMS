{
  "name": "Secure Roulette PRO",
  "slug": "secure-roulette",
  "version": "2.1.0",
  "author": "Omega MU CMS",
  "description": "Ruleta de premios server-side para OMEGA CMS con probabilidades configurables, costo por giro, límites diarios, campañas, auditoría y estadísticas.",
  "minimum_core": "0.18.0",
  "enabled_by_default": true,
  "user_menu": {
    "label": "Ruleta Segura",
    "icon": "🎰",
    "order": 30
  },
  "config_schema": [
    {
      "key": "enabled",
      "label": "Ruleta habilitada",
      "type": "boolean",
      "default": true
    },
    {
      "key": "cooldown_minutes",
      "label": "Cooldown entre giros (minutos)",
      "type": "integer",
      "default": 1440,
      "min": 0,
      "max": 525600,
      "help": "0 = sin cooldown funcional. Se mantiene un anti-doble-submit técnico."
    },
    {
      "key": "history_limit",
      "label": "Historial mostrado al usuario",
      "type": "integer",
      "default": 20,
      "min": 5,
      "max": 100
    },
    {
      "key": "daily_spin_limit",
      "label": "Máximo de giros diarios",
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 1000,
      "help": "0 = sin límite diario. El cooldown sigue aplicándose de forma independiente."
    },
    {
      "key": "require_offline",
      "label": "Exigir cuenta desconectada",
      "type": "boolean",
      "default": false,
      "help": "Bloquea el giro si la cuenta está conectada al servidor."
    },
    {
      "key": "campaign_start",
      "label": "Inicio de campaña (opcional)",
      "type": "string",
      "default": "",
      "help": "Formato YYYY-MM-DD HH:MM:SS. Vacío = sin fecha inicial."
    },
    {
      "key": "campaign_end",
      "label": "Fin de campaña (opcional)",
      "type": "string",
      "default": "",
      "help": "Formato YYYY-MM-DD HH:MM:SS. Vacío = sin fecha final."
    },
    {
      "key": "spin_cost_type",
      "label": "Moneda del costo por giro",
      "type": "select",
      "default": "None",
      "options": {
        "None": "Gratis",
        "WCoinC": "WCoinC",
        "WCoinP": "WCoinP",
        "GoblinPoint": "GoblinPoint",
        "Credits": "Credits"
      }
    },
    {
      "key": "spin_cost_amount",
      "label": "Costo por giro",
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 1000000,
      "help": "Se descuenta dentro de la misma transacción que determina y acredita el premio."
    },
    {
      "key": "slot1_type",
      "label": "Premio 1 - Tipo",
      "type": "select",
      "default": "WCoinC",
      "options": {
        "WCoinC": "WCoinC",
        "WCoinP": "WCoinP",
        "GoblinPoint": "GoblinPoint",
        "Credits": "Credits"
      }
    },
    {
      "key": "slot1_amount",
      "label": "Premio 1 - Cantidad",
      "type": "integer",
      "default": 10,
      "min": 0,
      "max": 1000000
    },
    {
      "key": "slot1_weight",
      "label": "Premio 1 - Peso / probabilidad",
      "type": "integer",
      "default": 100,
      "min": 0,
      "max": 1000000,
      "help": "Peso relativo. 0 desactiva esta casilla. La probabilidad real se calcula contra la suma de todos los pesos."
    },
    {
