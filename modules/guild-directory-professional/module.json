{
  "name": "Guild Directory Professional",
  "slug": "guild-directory-professional",
  "version": "1.0.0",
  "author": "Omega MU CMS",
  "description": "Directorio profesional de clanes con logo, notice, Guild Master, miembros y suma total de resets.",
  "minimum_core": "0.18.0",
  "enabled_by_default": true,
  "user_menu": {
    "label": "Clanes",
    "icon": "🏰",
    "order": 40
  },
  "config_schema": [
    {
      "key": "page_limit",
      "label": "Clanes por página",
      "type": "integer",
      "default": 50,
      "min": 10,
      "max": 200,
      "help": "Cantidad máxima de clanes a mostrar."
    },
    {
      "key": "default_sort",
      "label": "Orden predeterminado",
      "type": "select",
      "default": "resets",
      "options": {
        "resets": "Total Resets",
        "members": "Cantidad de miembros",
        "score": "Guild Score",
        "name": "Nombre"
      }
    },
    {
      "key": "show_score",
      "label": "Mostrar Guild Score",
      "type": "boolean",
      "default": true
    },
    {
      "key": "show_notice",
      "label": "Mostrar Notice",
      "type": "boolean",
      "default": true
    },
    {
      "key": "show_member_preview",
      "label": "Mostrar integrantes destacados",
      "type": "boolean",
      "default": true
    }
  ]
}